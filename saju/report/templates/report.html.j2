<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ product.name }} · {{ f.person.name }}님</title>
<link rel="stylesheet" href="style.css">{% if product.header %}<style>@page { @top-left { content: "{{ product.header }}"; } }</style>{% endif %}
</head>
<body>
{%- set P = f.person %}

{# ── 글 칸 ─────────────────────────────────────── #}
{% macro text(pg) -%}
{%- set t = texts.get(pg.slot.id) if pg.slot else None -%}
{%- if t is none -%}
{%- elif pg.slot.format == "paragraphs" -%}
  {% for x in t %}<p>{{ x|para }}</p>{% endfor %}
{%- elif pg.slot.format == "lead" -%}
  <div class="lead">{{ t.lead|para }}</div>
  {% for x in t.paragraphs %}<p>{{ x|para }}</p>{% endfor %}
{%- elif pg.slot.format == "bullets" -%}
  <ul>{% for b in t %}<li>{{ b|bullet }}</li>{% endfor %}</ul>
{%- elif pg.slot.format == "summary" -%}
  <div class="box"><div class="note-head"><span class="seal">要</span><span class="note-title">이 장의 핵심</span></div>
  <ul style="margin:0; padding-left: 6mm">{% for b in t.bullets %}<li>{{ b|bullet }}</li>{% endfor %}</ul></div>
  <div style="border-top: 1pt dashed #8a7550; padding-top: 3mm; margin-top: 4mm">
    <div class="han" style="color: #9e2f22; font-size: 16pt">금월선녀의 한마디</div><p>{{ t.word|para }}</p></div>
{%- elif pg.slot.format == "plan" -%}
  {% for x in t.notes or [] %}<p>{{ x|para }}</p>{% endfor %}
  <table class="compact"><tr><th style="width: 23%">언제</th><th class="left">할 일</th><th class="left">피할 일</th></tr>
  {% for r in t.rows %}<tr><th>{{ r.when }}</th><td class="left">{{ r.do }}</td><td class="left">{{ r.avoid }}</td></tr>{% endfor %}</table>
{%- elif pg.slot.format == "qa" -%}
  {% for it in t["items"] %}<div class="qa"><p class="q">Q. {{ it.q }}</p><p class="a">{{ it.a|para }}</p></div>{% endfor %}
{%- elif pg.slot.format == "checklist" -%}
  <ul class="checklist">{% for b in t %}<li>{{ b|bullet }}</li>{% endfor %}</ul>
{%- elif pg.slot.format == "fortune" -%}
  <p class="fortune-sum">{{ t.summary|para }}</p>
  {% for it in t["items"] %}<p class="item"><span class="item-label">{{ it.label }}</span><br>{{ it.text|para }}</p>{% endfor %}
  <p class="item"><span class="item-label">이렇게 보내세요</span><br>{{ t.advice|para }}</p>
{%- endif -%}
{%- endmacro %}

{% macro term_box(terms) -%}
{%- set ts = terms | select("in", glossary) | list -%}
{%- if ts -%}
<div class="box terms"><div class="note-head"><span class="seal">註</span><span class="note-title">이 말이 뭐예요?</span></div>
{% for t in ts %}<p><b>{{ t }}</b><br>{{ glossary[t] }}</p>{% endfor %}</div>
{%- endif -%}
{%- endmacro %}

{# ── 그림 ─────────────────────────────────────── #}
{% macro figure(pg, sec) -%}
{%- set k = pg.figure -%}
{%- if k == "toc" -%}
  {% if product.toc_compact %}<div class="toc-compact">{% endif %}
  {% for s in sections %}
  <div class="toc-sec"><span class="no">{{ secmark.get(s.no, s.no) }}</span>
    <span class="t" data-target="#sec-{{ s.no }}"><b class="tt">{{ s.title }}</b>{% if s.subtitle and s.no not in secmark %}<br><span class="s">{{ s.subtitle }}</span>{% endif %}</span></div>
  {% endfor %}
  {% if product.toc_compact %}</div>{% endif %}
{%- elif k == "four_pillars_diagram" -%}
  <table><tr><th>시간</th><th>날</th><th>달</th><th>해</th></tr>
  <tr>{% for i in [3,2,1,0] %}<td class="big-han">{{ "時日月年"[3-i] }}</td>{% endfor %}</tr>
  <tr><td colspan="4" class="sub">사주표는 오른쪽에서 왼쪽으로 해 → 달 → 날 → 시간 순서로 읽어요</td></tr></table>
{%- elif k == "element_cycle" -%}
  {{ svg.element_cycle | safe }}
{%- elif k == "stems_branches" -%}
  <table><tr><th>천간</th>{% for s in kb.stems %}<td><span class="mid-han">{{ s.hanja }}</span><br>{{ s.name }}</td>{% endfor %}</tr>
  <tr><th>오행</th>{% for s in kb.stems %}<td>{{ s.el }}</td>{% endfor %}</tr></table>
  <table><tr><th>지지</th>{% for b in kb.branches[:6] %}<td><span class="mid-han">{{ b.hanja }}</span><br>{{ b.name }}</td>{% endfor %}</tr>
  <tr><th>띠</th>{% for b in kb.branches[:6] %}<td>{{ b.animal }}</td>{% endfor %}</tr>
  <tr><th>지지</th>{% for b in kb.branches[6:] %}<td><span class="mid-han">{{ b.hanja }}</span><br>{{ b.name }}</td>{% endfor %}</tr>
  <tr><th>띠</th>{% for b in kb.branches[6:] %}<td>{{ b.animal }}</td>{% endfor %}</tr></table>
{%- elif k == "symbols" -%}
  <table>{% for a, b in static.symbols %}<tr><th style="width: 34%">{{ a }}</th><td class="left">{{ b }}</td></tr>{% endfor %}</table>
  <div class="box"><p>이 책의 모든 계산은 {{ P.birth_text }} {{ P.time_text }}, {{ P.place }} 출생을 기준으로 했어요.</p></div>
{%- elif k == "pillars" -%}
  <table>
  <tr><th></th>{% for p in f.pillars|reverse %}<th>{{ p.label }}</th>{% endfor %}</tr>
  <tr><th>천간</th>{% for p in f.pillars|reverse %}<td>{% if p.unknown %}?{% else %}<span class="big-han">{{ p.stem_hanja }}</span><br>{{ p.stem }} · {{ p.stem_element }}{% endif %}</td>{% endfor %}</tr>
  <tr><th>지지</th>{% for p in f.pillars|reverse %}<td>{% if p.unknown %}?{% else %}<span class="big-han">{{ p.branch_hanja }}</span><br>{{ p.branch }} · {{ p.branch_element }}{% endif %}</td>{% endfor %}</tr>
  <tr><th>띠</th>{% for p in f.pillars|reverse %}<td>{{ p.animal or "" }}</td>{% endfor %}</tr>
  </table>
  {% if f.uncertainties %}<div class="box">{% for u in f.uncertainties %}<p>※ {{ u }}</p>{% endfor %}</div>{% endif %}
{%- elif k == "pillars_detail" -%}
  <table>
  <tr><th></th>{% for p in f.pillars|reverse %}<th>{{ p.label }}</th>{% endfor %}</tr>
  <tr><th>간지</th>{% for p in f.pillars|reverse %}<td class="mid-han">{{ p.hanja or "?" }}</td>{% endfor %}</tr>
  <tr><th>천간 십신</th>{% for p in f.pillars|reverse %}<td>{{ p.stem_ten_god or "" }}</td>{% endfor %}</tr>
  <tr><th>지지 십신</th>{% for p in f.pillars|reverse %}<td>{{ p.branch_ten_god or "" }}</td>{% endfor %}</tr>
  <tr><th>지장간</th>{% for p in f.pillars|reverse %}<td>{% for h in p.hidden_stems or [] %}{{ h.stem }}<br>{% endfor %}</td>{% endfor %}</tr>
  <tr><th>12운성</th>{% for p in f.pillars|reverse %}<td>{{ p.twelve_stage or "" }}</td>{% endfor %}</tr>
  </table>
{%- elif k == "elements_bar" -%}
  <div class="bars">{% for e in f.elements %}
    <div class="bar-row"><span class="bar-label"><span class="han">{{ e.hanja }}</span> {{ e.name }}</span>
    <span class="bar-track"><span class="bar-fill el-{{ e.el }}" style="display:block; width: {{ [e.pct, 1]|max }}%"></span></span>
    <span class="bar-pct">{{ e.pct }}% {% if e.status != "보통" %}<b>{{ e.status }}</b>{% endif %}</span></div>{% endfor %}</div>
  <p class="sub">글자 수: {% for e in f.elements %}{{ e.name }} {{ e.count }}개{% if not loop.last %} · {% endif %}{% endfor %} (계절과 자리의 힘을 반영해 비율을 계산했어요)</p>
{%- elif k == "tengod_table" -%}
  <table><tr><th>무리</th><th>십신</th><th class="left">뜻</th></tr>
  {% for g in f.ten_god_groups %}<tr><th>{{ g.group }}<br><span class="sub">{{ g.label }}</span></th><td>{{ g.members }}</td><td class="left">{{ g.meaning }}</td></tr>{% endfor %}</table>
{%- elif k == "tengod_dots" -%}
  <table>{% for g in f.ten_god_groups %}<tr><th style="width: 22%">{{ g.group }}<br><span class="sub">{{ g.label }}</span></th>
  <td style="width: 22%" class="dots">{{ "●" * g.n if g.n else "○" }}</td><td class="left">{{ g.note or g.meaning }}</td></tr>{% endfor %}</table>
{%- elif k == "stage_table" -%}
  <table class="compact">{% for name, text in kb.stages %}<tr><th style="width: 18%">{{ name }}</th><td class="left">{{ text }}</td></tr>{% endfor %}</table>
{%- elif k == "my_stages" -%}
  <table><tr>{% for p in f.pillars|reverse %}<th>{{ p.label }}</th>{% endfor %}</tr>
  <tr>{% for p in f.pillars|reverse %}<td class="mid-han">{{ p.twelve_stage or "?" }}</td>{% endfor %}</tr></table>
{%- elif k == "hidden" -%}
  <table><tr><th>자리</th><th>지지</th><th class="left">숨은 글자(십신)</th></tr>
  {% for p in f.pillars if not p.unknown %}<tr><th>{{ p.label }}</th><td class="mid-han">{{ p.branch_hanja }}</td><td class="left">{{ p.hidden_text }}</td></tr>{% endfor %}</table>
{%- elif k == "relation_table" -%}
  <table class="compact">{% for name, text in kb.relations %}<tr><th style="width: 18%">{{ name }}</th><td class="left">{{ text }}</td></tr>{% endfor %}</table>
{%- elif k == "my_relations" -%}
  {% if f.relations %}<table class="compact"><tr><th>관계</th><th>글자</th><th class="left">뜻</th></tr>
  {% for r in f.relations %}<tr><th>{{ r.type }}</th><td>{{ r.chars }}</td><td class="left">{{ r.text }}</td></tr>{% endfor %}</table>
  {% else %}<div class="box"><p>타고난 여덟 글자 안에는 서로 합치거나 부딪히는 관계가 없어요.</p></div>{% endif %}
{%- elif k == "shinsal_table" -%}
  <table class="compact">{% for name, text in kb.shinsal %}<tr><th style="width: 22%">{{ name }}</th><td class="left">{{ text }}</td></tr>{% endfor %}</table>
{%- elif k == "my_shinsal" -%}
  {% if f.shinsal %}<table class="compact"><tr><th>신살</th><th>자리</th><th class="left">뜻</th></tr>
  {% for s in f.shinsal %}<tr><th>{{ s.name }}</th><td>{{ s.label }}</td><td class="left">{{ s.text }}</td></tr>{% endfor %}</table>
  {% else %}<div class="box"><p>눈에 띄는 신살이 없는 사주예요.</p></div>{% endif %}
{%- elif k == "strength" -%}
  {{ svg.strength | safe }}
  <table><tr><th style="width: 24%">신강·신약</th><td class="left"><b>{{ f.strength.label }}</b> ({{ f.strength.score }}점) · {{ f.strength.text }}</td></tr>
  <tr><th>격국</th><td class="left"><b>{{ f.gyeokguk.name }}</b> · {{ f.gyeokguk.text }}</td></tr>
  <tr><th>용신</th><td class="left"><b>{{ f.lucky.element_name }}({{ f.lucky.element }})</b> · {{ f.lucky.basis }}</td></tr></table>
{%- elif k == "classics" and f.classics -%}
  {%- set c = f.classics -%}
  <table class="compact"><tr><th style="width: 27%">뼈대<br>(자평진전)</th><td class="left"><b>{{ c.gyeok }} · {{ c.verdict }}</b><br>{{ c.verdict_text }}</td></tr>
  <tr><th>격을 살리는<br>글자(상신)</th><td class="left"><b>{{ c.sangsin }}({{ c.sangsin_element }})</b> · {{ "사주 안에 있어요" if c.sangsin_present else "운에서 들어올 때 크게 풀려요" }}</td></tr>
  {% for g in c.good %}<tr><th>좋은 점</th><td class="left">{{ g }}</td></tr>{% endfor %}
  {% for g in c.bad %}<tr><th>흠</th><td class="left">{{ g }}</td></tr>{% endfor %}
  {% if c.special %}<tr><th>특별한 격<br>(적천수)</th><td class="left"><b>{{ c.special.name }}</b> · {{ c.special.why }}</td></tr>{% endif %}
  <tr><th>계절의 온도<br>(적천수 조후)</th><td class="left">{{ c.johu.text }}</td></tr>
  {% if c.tonggwan %}<tr><th>이어 주는 기운<br>(통관)</th><td class="left">{{ c.tonggwan.text }}</td></tr>{% endif %}
  {% if c.image %}<tr><th>나의 모습<br>(물상)</th><td class="left"><b>{{ c.image.title }}</b> · {{ c.image.text }}</td></tr>{% endif %}
  {% for pr in c.pairs %}<tr><th>글자의 만남<br>(물상)</th><td class="left"><b>{{ pr.title }}</b> · {{ pr.text }}</td></tr>{% endfor %}
  </table>
{%- elif k in ("career_years", "money_years", "love_years") -%}
  {%- set hl = {"career_years": ["편관","정관","식신","상관"], "money_years": ["편재","정재","식신"],
                "love_years": (["편재","정재"] if P.sex == "male" else ["편관","정관"])}[k] -%}
  <table><tr><th>해</th><th>간지</th><th>들어오는 기운</th><th>흐름</th></tr>
  {% for s in f.sewoon %}<tr{% if s.stem_ten_god in hl or s.branch_ten_god in hl %} style="background: #e9dfc6"{% endif %}>
  <th>{{ s.year }}</th><td><span class="han">{{ s.hanja }}</span> {{ s.ganzhi }}</td><td>{{ s.stem_ten_god }} · {{ s.branch_ten_god }}</td><td>{{ s.score }}점</td></tr>{% endfor %}</table>
{%- elif k == "health_notice" -%}
  <div class="box"><p>※ {{ static.health_notice }}</p></div>
{%- elif k == "daewoon_info" -%}
  <table><tr><th>대운수</th><td>{{ f.daewoon.number }}세</td><th>방향</th><td>{{ f.daewoon.direction }}</td></tr></table>
  <p class="sub">첫 대운이 {{ f.daewoon.number }}세에 시작해 10년마다 바뀌어요. {{ "앞으로 흘러가는(순행)" if f.daewoon.direction == "순행" else "거꾸로 흘러가는(역행)" }} 대운이에요.</p>
{%- elif k == "life_graph" -%}
  {{ svg.life_graph | safe }}
{%- elif k == "daewoon_card" -%}
  {%- set d = f.daewoon.periods[pg.period_index] -%}
  <div class="fortune-head{% if d.state == '지난' %} past{% endif %}"><span class="mid-han">{{ d.hanja }}</span>
    <span><b>{{ d.age_text }}</b> · {{ d.years_text }}<br>{{ d.stem_ten_god }} · {{ d.branch_ten_god }}</span>
    <span class="score">{{ d.state }}<br><b>{{ d.score }}점</b></span></div>
  {% if d.relations_text %}<p class="fortune-rel">내 사주와의 관계: {{ d.relations_text|join(", ") }}</p>{% endif %}
{%- elif k == "daewoon_tail" -%}
  <table>{% for d in f.daewoon.periods if d.order - 1 > [f.daewoon.current_index, 0]|max + 4 %}
  <tr><th>{{ d.age_text }}</th><td class="mid-han">{{ d.hanja }}</td><td>{{ d.stem_ten_god }} · {{ d.branch_ten_god }}</td><td>{{ d.score }}점</td></tr>{% endfor %}</table>
{%- elif k == "sewoon_card" -%}
  {%- set s = (f.sewoon | selectattr("year", "equalto", pg.year) | first) -%}
  <div class="fortune-head"><span class="mid-han">{{ s.hanja }}</span>
    <span><b>{{ s.year }}년 {{ s.ganzhi }}년</b> · {{ s.animal }}띠 해<br>{{ s.stem_ten_god }} · {{ s.branch_ten_god }}</span>
    <span class="score">흐름<br><b>{{ s.score }}점</b></span></div>
  {% if s.relations_text %}<p class="fortune-rel">내 사주와의 관계: {{ s.relations_text|join(", ") }}</p>{% endif %}
{%- elif k == "months3" -%}
  {%- set t = texts.get(pg.slot.id, {}).get("months", []) -%}
  {% for m in f.months[pg.month_range[0]:pg.month_range[1]] %}
  <div class="month"><div class="month-head"><span class="mid-han">{{ m.hanja }}</span>
    <b>{{ m.year }}년 {{ m.month }}월 · {{ m.short }} {{ m.term }}부터</b><span class="sub" style="margin-left:auto">{{ m.score }}점</span></div>
    {% set mt = t[loop.index0] if t|length > loop.index0 else None %}
    {% if mt %}<p>{{ mt.summary|para }}</p>
    <div class="two-col"><div><span class="item-label">좋은 일</span><br>{{ mt.good|para }}</div><div><span class="item-label">주의할 일</span><br>{{ mt.careful|para }}</div></div>{% endif %}
  </div>{% endfor %}
{%- elif k == "question" -%}
  <div class="box"><b>남겨 주신 질문</b><p>{{ f.order.question or "질문을 남기지 않으셨어요. 요즘 생활에 맞춰 가장 많이 궁금해하시는 내용으로 답해 드려요." }}</p></div>
{%- elif k == "yongsin" -%}
  <div class="center"><span class="big-han" style="font-size: 54pt">{{ f.lucky.hanja }}</span><br><b>{{ f.lucky.element_name }}({{ f.lucky.element }}) 기운</b></div>
{%- elif k == "lucky" -%}
  <table><tr><th>행운의 색</th><td class="left">{{ f.lucky.color }}</td></tr>
  <tr><th>행운의 숫자</th><td class="left">{{ f.lucky.numbers }}</td></tr>
  <tr><th>좋은 방향</th><td class="left">{{ f.lucky.direction }}</td></tr>
  <tr><th>힘이 나는 계절</th><td class="left">{{ f.lucky.season }}</td></tr></table>
{%- elif k == "lucky_items" -%}
  <table><tr><th style="width: 24%">음식</th><td class="left">{{ f.lucky.foods }}</td></tr>
  <tr><th>물건·공간</th><td class="left">{{ f.lucky["items"] }}</td></tr></table>
{%- elif k == "animals" -%}
  <table><tr><th>나의 띠</th><td>{{ P.zodiac }}띠</td></tr><tr><th>잘 맞는 띠</th><td>{{ f.lucky.animals|join(", ") }}띠</td></tr>
  <tr><th>조심할 띠</th><td>{{ f.lucky.careful_animal }}띠</td></tr></table>
{%- elif k == "summary_table" -%}
  <table><tr><th style="width: 26%">나를 나타내는 글자</th><td class="left">{{ f.day_master.stem }}({{ f.day_master.hanja }}) · {{ f.day_master.image }}</td></tr>
  <tr><th>사주의 틀</th><td class="left">{{ f.strength.label }} · {{ f.gyeokguk.name }}</td></tr>
  <tr><th>지금 대운</th><td class="left">{% set d = f.daewoon.periods[[f.daewoon.current_index,0]|max] %}{{ d.age_text }} {{ d.ganzhi }}</td></tr>
  <tr><th>행운</th><td class="left">{{ f.lucky.color }} · {{ f.lucky.numbers }} · {{ f.lucky.direction }}</td></tr></table>
{%- elif k == "cross_sell" -%}
  <p>{{ product.more_intro }} 이름이나 '바로 보기'를 누르면 운명서재의 해당 페이지로 이동해요.</p>
  {% for p in more %}
  <div class="product">
    <div class="product-head"><a href="{{ p.url }}"><b class="han">{{ p.name }}</b></a><span class="price"><s>{{ p.original_text }}</s> <em>{{ p.discount }}%</em> <strong>{{ p.price_text }}</strong></span></div>
    <p class="product-line">{{ p.line }}</p>
    <p>{{ p.hook }} <a class="go" href="{{ p.url }}">바로 보기 →</a></p>
  </div>{% endfor %}
  <p class="end-mark">運命書齋 · 금월선녀</p>
{%- elif k == "love_letters" -%}
  {%- set r = f.romance -%}
  <table class="compact"><tr><th style="width: 27%">배우자 자리<br>(일지)</th><td class="left"><span class="mid-han">{{ r.day_branch.hanja }}</span> {{ r.day_branch.branch }} · {{ r.day_branch.ten_god }} · {{ r.day_branch.animal }}</td></tr>
  <tr><th>배우자 별<br>({{ r.spouse_group }})</th><td class="left">{% if r.spouse_seats %}{% for s in r.spouse_seats %}{{ s.label }} {{ s.where|join(", ") }}{% if not loop.last %} · {% endif %}{% endfor %}{% else %}타고난 사주에는 없어요. 운에서 들어올 때 인연이 와요.{% endif %}</td></tr>
  <tr><th>도화·홍염</th><td class="left">{{ r.peach|join(", ") if r.peach else "타고난 사주에는 없어요" }} · 도화가 드는 글자: {{ r.peach_branches|join(", ") }}</td></tr></table>
{%- elif k == "love_glance" -%}
  {%- set r = f.romance -%}
  <table class="compact"><tr><th style="width: 27%">인연이 오는 해</th><td class="left"><b>{{ r.best_years|join("년, ") }}년</b></td></tr>
  <tr><th>가까운 좋은 달</th><td class="left"><b>{{ r.best_months|join(", ") }}</b></td></tr>
  {% if r.careful_months %}<tr><th>조심할 달</th><td class="left">{{ r.careful_months|join(", ") }}</td></tr>{% endif %}
  <tr><th>그 사람의 자리</th><td class="left">{{ r.day_branch.branch }}({{ r.day_branch.hanja }}) · {{ r.day_branch.ten_god }}</td></tr>
  {% if r.main_seat %}<tr><th>만나기 쉬운 곳</th><td class="left">{{ r.main_seat.route }}</td></tr>
  <tr><th>나이 차이</th><td class="left">{{ r.main_seat.age_gap }}</td></tr>{% endif %}
  {% if r.marriage_periods %}<tr><th>결혼 인연 시기</th><td class="left">{% for p in r.marriage_periods %}{{ p.age_text }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>{% endif %}</table>
{%- elif k == "spouse_seat" -%}
  {%- set r = f.romance -%}
  <table class="compact"><tr><th style="width: 27%">일지 글자</th><td class="left"><span class="mid-han">{{ r.day_branch.hanja }}</span> {{ r.day_branch.branch }} · {{ r.day_branch.element }} · {{ r.day_branch.animal }}</td></tr>
  <tr><th>십신 · 12운성</th><td class="left">{{ r.day_branch.ten_god }} · {{ r.day_branch.stage }}</td></tr>
  <tr><th>숨은 글자</th><td class="left">{{ r.day_branch.hidden }}</td></tr>
  {% for x in r.day_branch_relations %}<tr><th>{{ x.with }}{{ "과" if x.with[-1] in "날달" else "와" }} {{ x.kind }}</th><td class="left">{{ x.text }}</td></tr>{% endfor %}</table>
{%- elif k == "love_match" -%}
  <table class="compact"><tr><th style="width: 27%">도움 되는 기운</th><td class="left">{{ f.lucky.element_name }}({{ f.lucky.element }})</td></tr>
  <tr><th>잘 맞는 띠</th><td class="left">{{ f.lucky.animals|join(", ") }}띠</td></tr>
  <tr><th>조심할 띠</th><td class="left">{{ f.lucky.careful_animal }}띠</td></tr></table>
{%- elif k == "love_graph" -%}
  {{ svg.love_graph | safe }}
  <p class="sub">대운(10년)마다 배우자 별, 배우자 자리와의 합, 도화가 들어오면 점수가 올라가요. 참고용 점수예요.</p>
{%- elif k == "love_years5" -%}
  <table class="compact"><tr><th>해</th><th>간지</th><th class="left">인연 표시</th><th>인연 점수</th></tr>
  {% for y in f.romance.years %}<tr{% if y.year in f.romance.best_years %} style="background: #e9dfc6"{% endif %}><th>{{ y.year }}</th><td><span class="han">{{ y.hanja }}</span> {{ y.ganzhi }}</td>
  <td class="left">{{ y.love_signs|join(", ") or "—" }}</td><td>{{ y.love_score }}점</td></tr>{% endfor %}</table>
{%- elif k == "love_months" -%}
  <table class="compact"><tr><th>달</th><th>간지</th><th class="left">인연 표시</th><th>점수</th></tr>
  {% for m in f.romance.months %}<tr{% if m.love_score >= 70 %} style="background: #e9dfc6"{% endif %}><th>{{ m.year }}.{{ m.month }}</th><td><span class="han">{{ m.hanja }}</span></td>
  <td class="left">{{ m.love_signs|join(", ") or "—" }}</td><td>{{ m.love_score }}</td></tr>{% endfor %}</table>
{%- elif k == "marriage_years" -%}
  <table class="compact"><tr><th>나이</th><th>해</th><th>대운</th><th class="left">인연 표시</th></tr>
  {% for p in f.romance.periods if p.state != "지난" %}<tr{% if p.love_star or p.love_hap %} style="background: #e9dfc6"{% endif %}><th>{{ p.age_text }}</th><td>{{ p.years_text }}</td><td><span class="han">{{ p.hanja }}</span></td><td class="left">{{ p.love_signs|join(", ") or "—" }}</td></tr>{% endfor %}</table>
{%- elif k == "love_summary" -%}
  {%- set r = f.romance -%}
  <table><tr><th style="width: 26%">나를 나타내는 글자</th><td class="left">{{ f.day_master.stem }}({{ f.day_master.hanja }}) · {{ f.day_master.image }}</td></tr>
  <tr><th>인연이 오는 해</th><td class="left">{{ r.best_years|join("년, ") }}년</td></tr>
  <tr><th>인연을 부르는 것</th><td class="left">{{ f.lucky.color }} · {{ f.lucky.direction }}</td></tr></table>
{%- elif k == "kv" -%}
  <table class="compact">{% for r in pg.rows %}<tr><th style="width: 27%">{{ r[0] }}</th><td class="left">{{ r[1] }}</td></tr>{% endfor %}</table>
  {% if pg.note %}<p class="sub">{{ pg.note }}</p>{% endif %}
{%- elif k == "grid" -%}
  {%- set g = pg.grid -%}
  <table class="compact"><tr>{% for h in g.head %}<th{% if loop.index0 in g.get("left", []) %} class="left"{% endif %}>{{ h }}</th>{% endfor %}</tr>
  {% for row in g.rows %}<tr{% if loop.index0 in g.get("hl", []) %} style="background: #e9dfc6"{% endif %}>{% for c in row %}{% if loop.first %}<th>{{ c }}</th>{% else %}<td{% if loop.index0 in g.get("left", []) %} class="left"{% endif %}>{{ c }}</td>{% endif %}{% endfor %}</tr>{% endfor %}</table>
  {% if pg.note %}<p class="sub">{{ pg.note }}</p>{% endif %}
{%- elif k == "theme_graph" -%}
  {{ svg.theme_graph | safe }}
  {% if pg.note %}<p class="sub">{{ pg.note }}</p>{% endif %}
{%- elif k == "pair_pillars" -%}
  {%- set o = f.partner -%}
  {% for who in [f, o] %}
  <table class="compact"><tr><th style="width: 20%">{{ who.person.name }}</th>{% for p in who.pillars|reverse %}<th>{{ p.label }}</th>{% endfor %}</tr>
  <tr><th>천간</th>{% for p in who.pillars|reverse %}<td>{% if p.unknown %}?{% else %}<span class="han">{{ p.stem_hanja }}</span> {{ p.stem_ten_god or "나" }}{% endif %}</td>{% endfor %}</tr>
  <tr><th>지지</th>{% for p in who.pillars|reverse %}<td>{% if p.unknown %}?{% else %}<span class="han">{{ p.branch_hanja }}</span> {{ p.branch_ten_god }}{% endif %}</td>{% endfor %}</tr></table>
  {% endfor %}
  {% if pg.note %}<p class="sub">{{ pg.note }}</p>{% endif %}
{%- elif k == "glossary" -%}
  <dl class="glossary">{% for t, d in glossary_sorted %}<dt>{{ t }}</dt><dd>{{ d }}</dd>{% endfor %}</dl>
{%- elif k == "raw_table" -%}
  <table><tr><th></th>{% for p in f.pillars|reverse %}<th>{{ p.label }}</th>{% endfor %}</tr>
  <tr><th>간지</th>{% for p in f.pillars|reverse %}<td>{{ p.ganzhi or "?" }}<br><span class="han">{{ p.hanja or "" }}</span></td>{% endfor %}</tr></table>
  <table><tr><th>대운</th>{% for d in f.daewoon.periods[:5] %}<td>{{ d.age_from }}<br>{{ d.ganzhi }}</td>{% endfor %}</tr>
  <tr><th></th>{% for d in f.daewoon.periods[5:] %}<td>{{ d.age_from }}<br>{{ d.ganzhi }}</td>{% endfor %}</tr></table>
  {% if f.variant_count > 1 %}<div class="box"><p>가능한 사주 후보: {{ f.variants|join(" / ") }}</p></div>{% endif %}
{%- elif k == "method" -%}
  <table>
  <tr><th style="width: 30%">입력한 출생 정보</th><td class="left">{{ P.birth_text }} ({{ "양력" if P.calendar == "solar" else "음력" if P.calendar == "lunar" else "양력·음력 미상" }}) {{ P.time_text }} · {{ P.place }} · {{ P.sex_word }}</td></tr>
  <tr><th>출생 시각 보정</th><td class="left">{{ "평균태양시(출생지 경도로 보정)" if f.options.solar_time == "mean" else "진태양시" if f.options.solar_time == "apparent" else "보정 없음" }}. 한국 표준시 변경과 서머타임 시기를 반영했어요.</td></tr>
  <tr><th>해·달의 기준</th><td class="left">해는 입춘, 달은 절기가 드는 시각에 바뀌어요.</td></tr>
  <tr><th>자시 기준</th><td class="left">{{ "밤 11시부터 다음 날로 봐요." if f.options.zi_rule == "23" else "자정부터 다음 날로 봐요(야자시)." }}</td></tr>
  <tr><th>계산 버전</th><td class="left">{{ f.version }}</td></tr></table>
  <p class="sub">만세력 사이트마다 시각 보정 방법이 달라 일부 글자가 다를 수 있어요.</p>
{%- endif -%}
{%- endmacro %}

{# ── 본문 ─────────────────────────────────────── #}
{%- set th = product.cover -%}
<style>
.cover { background: {{ th.glow_out }}; color: {{ th.text }}; }
.cover .label { border-color: {{ th.line }}; box-shadow: 0 0 0 1.5mm {{ th.dark }}; }
.cover .eight-head, .cover .eight th, .cover .brand { color: {{ th.line }}; }
.cover .eight table { background: {{ th.table }}; }
.cover .eight th, .cover .eight td { border-color: {{ th.line }}; }
.cover .eight td { color: {{ th.text }}; }
.cover .who b { color: {{ th.name }}; }
</style>
<section class="cover">
  <svg class="cover-art" viewBox="0 0 210 297" width="210mm" height="297mm" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="lattice" width="12" height="12" patternUnits="userSpaceOnUse">
        <path d="M0 6h3v-3h6v6h-3v-3" fill="none" stroke="{{ th.line }}" stroke-width=".25" opacity=".22"/>
        <path d="M6 12v-3h-3v3M12 0v3h-3" fill="none" stroke="{{ th.line }}" stroke-width=".25" opacity=".22"/>
      </pattern>
      <radialGradient id="glow" cx="50%" cy="38%" r="60%">
        <stop offset="0" stop-color="{{ th.glow_in }}"/><stop offset="1" stop-color="{{ th.glow_out }}"/>
      </radialGradient>
      <g id="cloud" fill="none" stroke="{{ th.line }}" stroke-width=".7" stroke-linecap="round">
        <path d="M0 8c0-4 5-6 8-3c1-4 8-5 10-1c3-3 9-1 8 4c3 0 4 4 1 5h-26c-3 0-3-5-1-5z"/>
        <path d="M6 10c2-2 5-1 5 1M15 8c2-2 6-1 6 2"/>
      </g>
      <g id="corner" fill="none" stroke="{{ th.line }}" stroke-width=".6">
        <path d="M0 0h16v4h-12v12h-4z"/><path d="M7 7h6v2h-4v4h-2z"/>
      </g>
    </defs>
    <rect width="210" height="297" fill="url(#glow)"/>
    <rect width="210" height="297" fill="url(#lattice)"/>
    <!-- 책을 묶은 실 (오침안정법) -->
    <rect width="17" height="297" fill="{{ th.dark }}"/>
    <line x1="17" y1="0" x2="17" y2="297" stroke="{{ th.line }}" stroke-width=".4" opacity=".6"/>
    <g fill="{{ th.darker }}" stroke="{{ th.line }}" stroke-width=".3">
      <circle cx="9" cy="22" r="1.1"/><circle cx="9" cy="85" r="1.1"/><circle cx="9" cy="148.5" r="1.1"/>
      <circle cx="9" cy="212" r="1.1"/><circle cx="9" cy="275" r="1.1"/>
    </g>
    <g stroke="{{ th.thread }}" stroke-width=".8" opacity=".85">
      <line x1="9" y1="22" x2="9" y2="275"/>
      <line x1="0" y1="22" x2="9" y2="22"/><line x1="0" y1="85" x2="9" y2="85"/><line x1="0" y1="148.5" x2="9" y2="148.5"/>
      <line x1="0" y1="212" x2="9" y2="212"/><line x1="0" y1="275" x2="9" y2="275"/>
      <line x1="9" y1="22" x2="9" y2="14"/><line x1="9" y1="275" x2="9" y2="283"/>
    </g>
    <!-- 금색 이중 테두리와 모서리 무늬 -->
    <rect x="25" y="11" width="176" height="275" fill="none" stroke="{{ th.line }}" stroke-width="1.1"/>
    <rect x="28" y="14" width="170" height="269" fill="none" stroke="{{ th.line }}" stroke-width=".35"/>
    <use href="#corner" x="31" y="17"/>
    <use href="#corner" transform="translate(195 17) scale(-1 1)"/>
    <use href="#corner" transform="translate(31 280) scale(1 -1)"/>
    <use href="#corner" transform="translate(195 280) scale(-1 -1)"/>
    <!-- 구름 -->
    <use href="#cloud" x="40" y="40" opacity=".55"/>
    <use href="#cloud" transform="translate(186 62) scale(-1.2 1.2)" opacity=".45"/>
    <use href="#cloud" transform="translate(42 150) scale(.8)" opacity=".35"/>
    <use href="#cloud" transform="translate(184 140) scale(-.9 .9)" opacity=".4"/>
    <!-- 해와 달 -->
    <circle cx="164" cy="34" r="6.5" fill="#9e2f22" opacity=".9"/>
    <circle cx="164" cy="34" r="9" fill="none" stroke="{{ th.line }}" stroke-width=".3"/>
    <path d="M56 30a7 7 0 1 0 6 11a5.5 5.5 0 1 1 -6 -11z" fill="#e9dfc6" opacity=".85"/>
    <!-- 산과 물결 -->
    <path d="M28 248l22-20l14 12l20-24l18 18l16-14l22 22l16-12l20 18l22-16v51h-170z" fill="{{ th.dark }}" opacity=".75"/>
    <path d="M28 248l22-20l14 12l20-24l18 18l16-14l22 22l16-12l20 18l22-16" fill="none" stroke="{{ th.line }}" stroke-width=".5" opacity=".7"/>
    <g fill="none" stroke="{{ th.line }}" stroke-width=".35" opacity=".45">
      <path d="M30 276q6-4 12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0"/>
      <path d="M30 281q6-4 12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0t12 0"/>
    </g>
  </svg>

  <div class="label"><div class="label-in">
    <div class="title">{{ product.cover_title|safe }}</div>
    <div class="subtitle">{{ product.name }}</div>
  </div></div>
  <div class="stamp">{{ f.day_master.hanja }}{{ f.pillars[2].branch_hanja or "" }}<small>{{ P.name }}</small></div>

  <div class="eight">
    <div class="eight-head">四 柱 八 字 · 나의 여덟 글자</div>
    <table>
      <tr>{% for p in f.pillars|reverse %}<th>{{ p.label }}</th>{% endfor %}</tr>
      <tr class="gz">{% for p in f.pillars|reverse %}<td>{{ "?" if p.unknown else p.stem_hanja }}</td>{% endfor %}</tr>
      <tr class="gz">{% for p in f.pillars|reverse %}<td>{{ "?" if p.unknown else p.branch_hanja }}</td>{% endfor %}</tr>
    </table>
  </div>

  <div class="who">
    <b class="customer-name">{{ P.name }} 님</b>
    <div>{{ P.birth_text }} {{ P.time_text }} · {{ P.place }}</div>
    <div>{{ P.sex_word }} · {{ P.zodiac }}띠</div>
    {% if f.partner %}<div>함께 보는 사람 · {{ f.partner.person.name }} 님</div>{% endif %}
  </div>
  <div class="brand">運命書齋 · 운명서재 · 금월선녀</div>
</section>

{% for sec in sections %}
  {% for pg in sec.pages if pg.figure != "cover" %}
  <section class="page" id="{{ 'sec-' ~ sec.no if loop.first else pg.id }}" data-pid="{{ pg.id }}"><span class="customer">{{ f.person.name }} 님</span>
    {% if pg.opener %}
    <div class="sec-head"><span class="sec-no">{{ secmark.get(sec.no, sec.no) }}</span>
      <div><div class="sec-title bookmark">{{ sec.title }}</div>{% if sec.subtitle %}<div class="sec-sub">{{ sec.subtitle }}</div>{% endif %}</div></div>
    {% endif %}
    {% if not (pg.opener and pg.title == sec.title) %}<h2>{{ pg.title }}</h2>{% endif %}
    {% if pg.static and pg.static in static %}{% for x in static[pg.static] %}<p>{{ x|para }}</p>{% endfor %}{% endif %}
    {% if pg.figure and pg.figure not in ("wrap", "opener") %}{{ figure(pg, sec) }}{% endif %}
    {% if pg.figure == "wrap" %}{{ term_box(sec.terms) }}{% endif %}
    {% if pg.figure != "months3" %}{{ text(pg) }}{% endif %}
  </section>
  {% endfor %}
{% endfor %}
</body>
</html>
